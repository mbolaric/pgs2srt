<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>pgs2srt third-party licenses</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0 auto; max-width: 960px; padding: 16px; color: #1b1f24; background: #ffffff; }
        a { color: #1b63e0; }
        pre { white-space: pre-wrap; background: #f3f5f8; padding: 12px; border-radius: 6px; font-size: 13px; }
        .used-by { columns: 3 220px; }
        @media (prefers-color-scheme: dark) {
            body { color: #e6e8eb; background: #15171a; }
            a { color: #8cb6fa; }
            pre { background: #1f2226; }
        }
    </style>
</head>
<body>
    <h1>Third-party licenses</h1>
    <p>
        pgs2srt is built from the Rust crates listed below. Native libraries (Tesseract, Leptonica and
        their dependencies) and the bundled OCR models have their notices in the <code>licenses</code> folder.
    </p>
    <h2>Overview</h2>
    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
        {{/each}}
    </ul>
    <h2>License texts</h2>
    {{#each licenses}}
    <section>
        <h3 id="{{id}}">{{name}}</h3>
        <p>Used by:</p>
        <ul class="used-by">
            {{#each used_by}}
            <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
            {{/each}}
        </ul>
        <pre>{{text}}</pre>
    </section>
    {{/each}}
</body>
</html>
